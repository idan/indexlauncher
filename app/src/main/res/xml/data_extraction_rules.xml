<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- A home screen should not transfer its future preferences without an explicit decision. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
